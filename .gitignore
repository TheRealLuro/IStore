# .gitignore — public ignore patterns for this repo.
#
# Sensitive paths that should never be in any clone (not even named in
# this file) belong in `.git/info/exclude` — that file is local-only and
# git never publishes it. Use this `.gitignore` for the obvious build /
# editor / language-cache patterns that aren't secrets in themselves.

# Self-ignore: this file is tracked, but local additions shouldn't be
# auto-staged via `git add .` — review them first to make sure nothing
# sensitive is leaking into the public ignore list.
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
env/

# Build / packaging
build/
dist/
*.egg

# uv
.uv-cache/
uv.lock

# Tests
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment / credentials
.env
.env.local
.env.*.local
!.env.example
secrets/*
!secrets/.gitkeep
*.pem
*.key
*.crt
*.p12
*.agekey
credentials*.json
*.token

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project — runtime data, never publish
data/
local_blobs/
backups/
exports/
uploads/
node_modules/
.claude/
claude/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.dump
*.sql
*.sql.gz
*.bak
*.sqlite3
*.sqlite
*.db
*.log

# tsc-generated outputs from .ts configs (we author the .ts; .js/.d.ts are derived)
frontend/vite.config.js
frontend/vite.config.d.ts
marketing/vite.config.js
marketing/vite.config.d.ts
*.tsbuildinfo

# §A7 — sensitive payload patterns. None of these should ever land in
# a public commit; the gitleaks CI step in `.github/workflows/security.yml`
# fails the build if a secret-shaped string slips past these patterns.
*.age              # age-encrypted ciphertext (backup files)
*.gpg              # legacy gpg ciphertext
*.enc              # generic encrypted blob
*.kdbx             # KeePass DB
id_rsa             # SSH private keys (rare, but blocklisted)
id_rsa.pub
id_ed25519
id_ed25519.pub
*.ovpn             # OpenVPN config (carries inline keys)
.netrc             # carries cleartext credentials
.npmrc             # often carries npm tokens
.pypirc            # carries PyPI tokens
.cargo/credentials
.docker/config.json

# Real user content — refuse to track anything that looks like it
# could be production data. Tests use synthetic byte-arrays generated
# in-process (see `_png_bytes`, `_docx_bytes` in tests/) — fixtures
# belong in tests/fixtures/synthetic/ if anywhere.
data/originals/
data/served/
data/faces/
data/quarantine/
data/exports/
fixtures/real/
samples/real/
**/personal_*

# Local dev databases that sometimes get dumped to the worktree
neuthek.db
istore.db
postgres-data/
pgdata/

# AI model weight caches — multi-GB, never tracked
.cache/
.hf_cache/
.transformers_cache/
~/.cache/huggingface/

# Coverage + profiling outputs
coverage.xml
*.coverage
.nyc_output/

# Local AI model artifacts that operators sometimes copy in
*.safetensors
*.onnx
*.gguf
*.bin
!frontend/node_modules/**/*.bin   # node_modules .bin shims are exec, not weights
