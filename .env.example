APP_ENV=dev

# Root directory holding ALL persistent state (postgres, minio, redis, models, backups).
# Dev: leave default (./data, relative to docker-compose.yml).
# Prod (Linux): mount your HDD then point this at it, e.g. /mnt/hdd/istore.
# Prod (Windows): a drive path, e.g. D:/istore.
ISTORE_DATA_ROOT=./data

POSTGRES_USER=istore
POSTGRES_PASSWORD=istore
POSTGRES_DB=istore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://istore:istore@localhost:5432/istore
DATABASE_URL_SYNC=postgresql+psycopg2://istore:istore@localhost:5432/istore

REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=istore
MINIO_SECRET_KEY=istorepass
MINIO_SECURE=false
MINIO_BUCKET_ORIGINALS=istore-originals
MINIO_BUCKET_SERVED=istore-served
MINIO_BUCKET_FACES=istore-faces

JWT_SECRET=replace-with-a-long-random-string
JWT_LIFETIME_SECONDS=86400
