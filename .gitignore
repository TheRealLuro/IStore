# .gitignore — public ignore patterns for this repo.
#
# Sensitive paths that should never be in any clone (not even named in
# this file) belong in `.git/info/exclude` — that file is local-only and
# git never publishes it. Use this `.gitignore` for the obvious build /
# editor / language-cache patterns that aren't secrets in themselves.

# Self-ignore: this file is tracked, but local additions shouldn't be
# auto-staged via `git add .` — review them first to make sure nothing
# sensitive is leaking into the public ignore list.
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
env/

# Build / packaging
build/
dist/
*.egg

# uv
.uv-cache/
uv.lock

# Tests
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment / credentials
.env
.env.local
.env.*.local
!.env.example
secrets/*
!secrets/.gitkeep
*.pem
*.key
*.crt
*.p12
*.agekey
credentials*.json
*.token

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project — runtime data, never publish
data/
local_blobs/
backups/
exports/
uploads/
node_modules/
.claude/
claude/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.dump
*.sql
*.sql.gz
*.bak
*.sqlite3
*.sqlite
*.db
*.log

# tsc-generated outputs from .ts configs (we author the .ts; .js/.d.ts are derived)
frontend/vite.config.js
frontend/vite.config.d.ts
*.tsbuildinfo
