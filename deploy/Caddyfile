{
	email {$ACME_EMAIL}
	servers {
		# Cloudflare edge — trust CF proxy ranges and read the real
		# visitor IP from CF-Connecting-IP so rate limits / lockouts /
		# audit logs key on the actual user, not a CF edge node. Refresh
		# from https://www.cloudflare.com/ips/. Harmless without CF in
		# front (these source IPs never match). See CLOUDFLARE_SETUP.md.
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 \
			103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 \
			190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 \
			198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 \
			2405:b500::/32 2405:8100::/32 2a06:98c0::/29 \
			2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

{$NEUTHEK_DOMAIN} {
	encode zstd gzip

	handle_path /minio/* {
		reverse_proxy {$NEUTHEK_MINIO_UPSTREAM}
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /auth/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /images/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /account/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /admin/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /consent/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /cloud/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	# Remaining API routers that live on the same origin. These are
	# pure-API prefixes with no SPA page collision (the public vault-link
	# VIEWER is served at /v/* and falls through to the frontend via the
	# catch-all below; only the /vault/* API is proxied here).
	#
	# NOTE: /billing is intentionally NOT blanket-proxied — its API paths
	# (e.g. /billing/checkout-session) would otherwise swallow the SPA's
	# /billing/checkout + /billing/return pages. Route billing per-path if
	# it must live same-origin.
	handle /vault/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /storage/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /search/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /people/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /faces/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /tags/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /folders/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /comments/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /shares/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /users/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle /feedback/* {
		reverse_proxy {$NEUTHEK_API_UPSTREAM}
	}

	handle {
		reverse_proxy {$NEUTHEK_FRONTEND_UPSTREAM}
	}
}
