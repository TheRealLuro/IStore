# Caddy site config for self-host TLS termination.
#
# Reads ${NEUTHEK_DOMAIN} and ${DOMAIN_ACME_EMAIL} from compose env.
# Caddy auto-acquires + renews certificates from Let's Encrypt for
# the configured domain. The backend stays on its private :8000.

{
    email {$DOMAIN_ACME_EMAIL}
    admin off
    servers {
        protocols h1 h2 h3
        # Cloudflare edge: when neuthek runs behind Cloudflare (proxied
        # DNS), the connecting IP Caddy sees is a Cloudflare edge node,
        # not the user. Trust Cloudflare's published ranges and read the
        # true client IP from `CF-Connecting-IP` so {client_ip},
        # rate-limits, and audit logs reflect the real visitor — not an
        # edge node (which would let one CF node exhaust a per-IP limit
        # for everyone). REFRESH this list from https://www.cloudflare.com/ips/.
        # Harmless when Cloudflare is NOT in front (those source IPs
        # simply never match, so {client_ip} == the direct remote).
        trusted_proxies static \
            173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 \
            103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 \
            190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 \
            198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
            104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
            2400:cb00::/32 2606:4700::/32 2803:f800::/32 \
            2405:b500::/32 2405:8100::/32 2a06:98c0::/29 \
            2c0f:f248::/32
        client_ip_headers Cf-Connecting-Ip X-Forwarded-For
    }
}

{$NEUTHEK_DOMAIN:localhost} {
    # Strip headers that leak server identity. Caddy advertises itself
    # via the Server header by default; security-review tools nag.
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # gzip + zstd both — zstd wins on modern browsers, gzip is the
    # universal fallback. Lossy compression handled inside the
    # backend's image pipeline, not here.
    encode zstd gzip

    # API + share-viewer + admin all live on the backend.
    reverse_proxy backend:8000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-For {remote_host}
        # 24h grace for long-running uploads — pg_dump backups,
        # 200MB archive uploads, etc.
        transport http {
            response_header_timeout 90s
            read_timeout 300s
            write_timeout 300s
        }
    }
}

# Optional: expose MinIO console on a sibling subdomain. Uncomment +
# point a CNAME at the host if operators want to admin MinIO via
# https://minio.${NEUTHEK_DOMAIN} instead of the unsigned :9001 port.
