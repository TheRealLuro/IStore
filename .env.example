# neuthek development defaults. Do not put production secrets in .env.
# Fresh installs land on `neuthek` / `neuthek-*` values. If you have
# a pre-rebrand install with `istore` / `istore-*` data on disk,
# pin the same values here so the rename doesn't orphan your DB
# rows or MinIO objects — every env var below wins over the compose
# default. The production validator
# (`backend.security.validate_production_settings`) treats both
# `neuthek` and the legacy `istore` literal as known-weak passwords
# and refuses to boot the API in prod with either.
APP_ENV=dev
FRONTEND_BASE_URL=http://localhost:5173

POSTGRES_USER=neuthek
POSTGRES_PASSWORD=neuthek
POSTGRES_DB=neuthek
DATABASE_URL=postgresql+asyncpg://neuthek:neuthek@localhost:5432/neuthek
DATABASE_URL_SYNC=postgresql+psycopg2://neuthek:neuthek@localhost:5432/neuthek
POSTGRES_AT_REST_ENCRYPTION=

REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=neuthek
MINIO_SECRET_KEY=neuthekpass
MINIO_SECURE=false
MINIO_BUCKET_ORIGINALS=neuthek-originals
MINIO_BUCKET_SERVED=neuthek-served
MINIO_BUCKET_FACES=neuthek-faces
MINIO_BUCKET_QUARANTINE=neuthek-quarantine
MINIO_SSE_MODE=off
MINIO_SSE_KMS_KEY_ID_CONTENT=
MINIO_SSE_KMS_KEY_ID_BIOMETRIC=

JWT_SECRET=dev-only-jwt-secret-CHANGE-IN-PROD
JWT_LIFETIME_SECONDS=86400
SECRET_MANAGER=env_file

UPLOAD_MAX_BYTES=209715200
UPLOAD_MAX_COUNT_PER_HOUR=300
UPLOAD_MAX_BYTES_PER_DAY=10737418240
UPLOAD_MAX_IMAGE_PIXELS=120000000
DOWNLOAD_URL_TTL_SECONDS=300
REQUIRE_SIGNED_DOWNLOADS=false
SECURITY_RATE_LIMITS_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=5
AUTH_LOCKOUT_FAILURES=5

BACKUP_AGE_RECIPIENT=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=neuthek <noreply@neuthek.local>

CLOUD_ENCRYPTION_KEY=
# Google OAuth — one client ID / secret used by BOTH:
#   1. "Sign in with Google"  (auth flow)
#   2. "Connect Google Drive" (cloud sync)
# Register at https://console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID (Web application). Add BOTH redirect
# URIs below to the client's "Authorized redirect URIs" list.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/cloud/callback/google_drive
GOOGLE_SIGNIN_REDIRECT_URI=http://localhost:8000/auth/google/callback

# §C2 — hourly cloud-sync sweep. Set CLOUD_SYNC_HOURLY_ENABLED=false to
# disable the background worker (test/dev environments without
# outbound HTTP, or operator-driven sync-only deployments).
CLOUD_SYNC_HOURLY_ENABLED=true
CLOUD_SYNC_INTERVAL_SECONDS=3600

# ---- Stripe billing (migration 0025) ----
# Leave empty in dev to keep `/billing/*` endpoints returning 503.
# In production, fetch these from Stripe Dashboard → Developers / Products:
#   - SECRET_KEY    : Developers → API keys → Secret key (sk_live_…)
#   - PUBLISHABLE   : Developers → API keys → Publishable key (pk_live_…)
#   - WEBHOOK_SECRET: Developers → Webhooks → Endpoint → Signing secret (whsec_…)
#   - PRICE_ID_*    : Products → <product> → Price ID (price_…)
# DO NOT COMMIT real values — keep them in `.env` (gitignored) or via
# Docker secrets (`STRIPE_SECRET_KEY_FILE=/run/secrets/stripe-key`).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_BUSINESS_MONTHLY=
STRIPE_PRICE_ID_BUSINESS_ANNUAL=
STRIPE_CHECKOUT_RETURN_URL=http://localhost:5173/billing/return?session_id={CHECKOUT_SESSION_ID}
